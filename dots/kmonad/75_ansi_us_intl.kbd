#| --------------------------------------------------------------------------

                     KMonad: US ansi 75% layout

(deflayer name
  _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _    _     _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _    _     _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _                    _
  _    _    _              _              _    _    _    _               _    _    _
)

  -------------------------------------------------------------------------- |#

(defcfg
  input  (device-file "/dev/input/by-id/usb-RDR_IQUNIX_MQ80_KB-event-kbd")
  output (uinput-sink "KMonad output")

  fallthrough true
)

(defalias
  ;; Layer switch
    tGA (layer-switch game)
    tQW (layer-switch qwerty)

  ;; Home row mods
    aa (tap-hold-next-release 500 a lalt)
    sc (tap-hold-next-release 500 s lctl)
    dm (tap-hold-next-release 500 d lmet)
    fs (tap-hold-next-release 500 f lsft)

    js (tap-hold-next-release 500 j rsft)
    km (tap-hold-next-release 500 k rmet)
    lc (tap-hold-next-release 500 l rctl)
    sa (tap-hold-next-release 500 ; ralt)

  ;; Macros
    mut (tap-macro M-1 C-S-m M-3)
    def (tap-macro M-1 C-S-d M-3)
)

(defsrc
  esc  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12  fn     ins  del      f13   f14   f15
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc        home     f16   f17   f18
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \           end      f19   f20   f21
  caps a    s    d    f    g    h    j    k    l    ;    '    ret              pgup     f22   f23   f24
  lsft z    x    c    v    b    n    m    ,    .    /    rsft        up        pgdn
  lctl lalt lmet           spc                 ralt rmet rctl   left down rght
)

(deflayer qwerty
  esc  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12  XX     ins  del      @tQW  @tGA  f15
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc        home     f16   f17   f18
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \           end      f19   f20   f21
  lsft @aa  @sc  @dm  @fs  g    h    @js  @km  @lc  @sa  '    rsft             pgup     f22   f23   f24
  ret  z    x    c    v    b    n    m    ,    .    /    C-bspc      up        pgdn
  lctl lalt lmet           spc                 ralt rmet rctl   left down rght
)

(deflayer game
  esc  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12  XX     ins  del      @tQW  @tGA  f15
  grv  2    2    3    4    5    6    7    8    9    0    -    =    bspc        @mut     f16   f17   f18
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \           @def     f19   f20   f21
  lsft a    s    d    f    g    h    j    k    l    ;    '    rsft             pgup     f22   f23   f24
  ret  z    x    c    v    b    n    m    ,    .    /    C-bspc      up        pgdn
  lctl lalt lmet           spc                 ralt rmet rctl   left down rght
)

