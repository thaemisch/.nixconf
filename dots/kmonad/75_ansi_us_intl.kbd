#| --------------------------------------------------------------------------

                     KMonad: US ansi 75% layout

(deflayer name
  _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _    _     _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _    _     _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _                    _
  _    _    _              _              _    _    _    _               _    _    _
)

  -------------------------------------------------------------------------- |#

(defcfg
  input  (device-file "/dev/input/by-id/usb-RDR_IQUNIX_MQ80_KB-event-kbd")
  output (uinput-sink "KMonad output")

  fallthrough true
)

(defalias
  ;; Layer toggle
    tNA (tap-hold 200 tab (layer-toggle nav))
    tS0 (tap-hold 200 ret (layer-toggle sym0))
    tS1 (tap-hold 200 lsft (layer-toggle sym1))
    tHM (tap-hold 10000 spc (layer-toggle home-row-mods))

  ;; Layer switch
    tGA (layer-switch game)
    tQW (layer-switch qwerty)
    tNH (layer-switch no-homerow-mods)

  ;; Home row mods
    aa (tap-hold-next-release 300 a lalt)
    sc (tap-hold-next-release 300 s lctl)
    dm (tap-hold-next-release 300 d lmet)
    fs (tap-hold-next-release 300 f lsft)

    js (tap-hold-next-release 300 j rsft)
    km (tap-hold-next-release 300 k rmet)
    lc (tap-hold-next-release 300 l rctl)
    sa (tap-hold-next-release 300 ; ralt)

  ;; Macros
    mut (tap-macro M-1 C-S-m M-3)
    def (tap-macro M-1 C-S-d M-3)
    cb (tap-macro C-bspc)

  ;; Tap-hold
    ret (tap-hold-next-release 200 ret rsft)
    sft (tap-hold-next-release 200 bspc lsft)

  ;; Symbols
    ua (tap-macro C-S-u 0 0 e 4 spc)
    uA (tap-macro C-S-u 0 0 c 4 spc)
    uu (tap-macro C-S-u 0 0 f c spc)
    uU (tap-macro C-S-u 0 0 d c spc)
    uo (tap-macro C-S-u 0 0 f 6 spc)
    uO (tap-macro C-S-u 0 0 d 6 spc)
    us (tap-macro C-S-u 0 0 d f spc)

    eu (tap-macro C-S-u 2 0 a c spc)
    al (tap-macro C-S-u 2 1 9 0 spc)
    au (tap-macro C-S-u 2 1 9 1 spc)
    ar (tap-macro C-S-u 2 1 9 2 spc)
    ad (tap-macro C-S-u 2 1 9 3 spc)

    yc (tap-macro C-S-u 2 7 0 5 spc)
    nc (tap-macro C-S-u 2 7 4 c spc)
    q (tap-macro C-S-u 2 7 5 3 spc)

    sk (tap-macro C-S-u 1 f 4 8 0 spc)
)

(defsrc
  esc  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12  -      ins  del      f13   f14   f15
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc        home     f16   f17   f18
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \           end      f19   f20   f21
  caps a    s    d    f    g    h    j    k    l    ;    '    ret              pgup     f22   f23
  lsft z    x    c    v    b    n    m    ,    .    /    rsft        up        pgdn
  lctl lalt lmet           spc                 f24  rmet rctl   left down rght
)


;; --------------------------------------------------------------------------
;; Layers PERMANENTLY

(deflayer qwerty
  esc  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12  XX     ins  del      @tQW  @tGA  @tNH
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc        home     f16   f17   f18
  @tNA q    w    e    r    t    y    u    i    o    p    [    ]    \           end      f19   f20   f21
  @sft a    s    d    f    g    h    j    k    l    ;    '    @ret             pgup     f22   f23
  @tS0 z    x    c    v    b    n    m    ,    .    /    C-bspc      up        pgdn
  lctl lalt lmet            spc                ralt _    rctl   left down rght
)

(deflayer home-row-mods
  esc  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12  XX     ins  del      @tQW  @tGA  @tNH
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc        home     f16   f17   f18
  @tNA q    w    e    r    t    y    u    i    o    p    [    ]    \           end      f19   f20   f21
  @sft @aa  @sc  @dm  @fs  g    h    @js  @km  @lc  @sa  '    @ret             pgup     f22   f23
  @tS0 z    x    c    v    b    n    m    ,    .    /    C-bspc      up        pgdn
  lctl lalt lmet           spc                 ralt _    rctl   left down rght
)

(deflayer game
  esc  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12  XX     ins  del      @tQW  @tGA  @tNH
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc        @mut     f16   f17   f18
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \           @def     f19   f20   f21
  @tS0 a    s    d    f    g    h    j    k    l    ;    '    ret              pgup     f22   f23
  lsft z    x    c    v    b    n    m    ,    .    /    rshift      up        pgdn
  lctl lalt lmet           spc                 ralt _    rctl   left down rght
)

(deflayer no-homerow-mods
  esc  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12  XX     ins  del      @tQW  @tGA  @tNH
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc        home     f16   f17   f18
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \           end      f19   f20   f21
  @tNA a    s    d    f    g    h    j    k    l    ;  '    @ret               pgup     f22   f23
  @tS0 z    x    c    v    b    n    m    ,    .    /    C-bspc      up        pgdn
  lctl lalt lmet           spc                 ralt _    rctl   left down rght
)

;; --------------------------------------------------------------------------

;; --------------------------------------------------------------------------
;; Layers TEMPORARILY

(deflayer nav
  esc  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12  XX     ins  del      @tQW  @tGA  f15
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc        home     f16   f17   f18
  tab  q    w    e    r    t    y    bspc up   ret  p    [    ]    \           end      f19   f20   f21
  @sft @aa  @sc  @dm  @fs  g    h    left down rght ;    '    @ret             pgup     f22   f23
  @tS0 z    x    c    v    b    n    m    ,    .    /    C-bspc      up        pgdn
  lctl lalt lmet           spc                 ralt _    rctl   left down rght
)

(deflayer sym0
  esc  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12  XX     ins  del      @tQW  @tGA  f15
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc        home     f16   f17   f18
  tab  q    w    @eu  r    t    @yc  @uu  @au  @uo  p    [    ]    \           end      f19   f20   f21
  @tS1 @ua  @us  d    f    g    h    @al  @ad  @ar  ;    '    @ret             pgup     f22   f23
  @tS0 z    x    c    v    @sk  @nc  m    ,    .    @q    C-bspc      up        pgdn
  lctl lalt lmet           spc                 ralt _    rctl   left down rght
)

(deflayer sym1
  esc  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12  XX     ins  del      @tQW  @tGA  f15
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc        home     f16   f17   f18
  tab  q    w    @eu  r    t    y    @uU  i    @uO  p    [    ]    \           end      f19   f20   f21
  @tS1 @uA  @us  d    f    g    h    j    k    l    ;    '    @ret             pgup     f22   f23
  @tS0 z    x    c    v    b    n    m    ,    .    /    C-bspc      up        pgdn
  lctl lalt lmet           spc                 ralt _    rctl   left down rght
)

